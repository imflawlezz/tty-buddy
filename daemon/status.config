[globals]
label_color = #888888
background_color = #000000

[header]
hostname_color = #FFFFFF
date_color = #888888
time_color = #FFFFFF
date_format = %d-%m-%Y
time_format = %H:%M:%S

[hero]
cpu_color = #FFFFFF
mem_color = #FFFFFF
disk_color = #FFFFFF
disk_mount = /
meter_mode = true
warn_at = 60
crit_at = 90
level_ok_color = #33AA33
level_warn_color = #CCCC33
level_crit_color = #CC3333

[secondary]
left = uptime
right = load
left_color = #FFFFFF
right_color = #FFFFFF

[interfaces]
wlp2s0 = auto
enp1s0 = auto
docker0 = auto

[services]
filter = all
active_color = #33AA33
failed_color = #CC3333
inactive_color = #888888
activating_color = #3399CC
reloading_color = #3399CC
deactivating_color = #CCAA33
maintenance_color = #888888

[alerts]
enabled = true
background_color = #990000
text_color = #FFFFFF
hold_sec = 30
temp_crit_c = 80
cpu_crit = true
mem_crit = true
disk_crit = true
temp_crit = true
service_failed = true
service_inactive = false

[osd]
default_brightness = 4        # 1=16% 2=33% 3=50% 4=67% 5=84% 6=100% or auto
sleep_timeout = 4             # 0/never 1=30s 2=1m 3=2m 4=5m 5=10m 6=30m
dismiss_alert_on_tap = true
wake_on_alert = true
auto_brightness = false
auto_day_level = 5
auto_night_level = 2
auto_day_hour = 7
auto_night_hour = 21
