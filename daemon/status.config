[globals]

label_color = #6B7C8F       # section labels (CPU, UPTIME:, SERVICES, ifaces, …)
background  = #000000       # full-screen background

# -----------------------------------------------------------------------------
# [header]  — hostname · date · time strip
#
# date_format / time_format are Python strftime patterns evaluated on the host.
#
#   token     meaning              example
#   -----     -------              -------
#   %Y        year, 4 digits       2026
#   %y        year, 2 digits       26
#   %m        month 01–12          09
#   %d        day 01–31            07
#   %b        month, short name    Sep
#   %B        month, full name     September
#   %a        weekday, short       Mon
#   %A        weekday, full        Monday
#   %H        hour 00–23           19
#   %I        hour 01–12           07
#   %M        minute 00–59         22
#   %S        second 00–59         04
#   %p        AM / PM              PM
#
#   date examples                  → result
#   %d-%m-%Y                       → 07-09-2026
#   %Y-%m-%d                       → 2026-09-07
#   %d/%m/%Y                       → 07/09/2026
#   %b %d, %Y                      → Sep 07, 2026
#   %A, %d %B %Y                   → Monday, 07 September 2026
#
#   time examples                  → result
#   %H:%M:%S                       → 19:22:04
#   %H:%M                          → 19:22
#   %I:%M %p                       → 07:22 PM
# -----------------------------------------------------------------------------
[header]

hostname_color = #C97878    # left: short hostname
date_color     = #6B7C8F    # middle: date string
time_color     = #FFFFFF    # right: clock

date_format = %d-%m-%Y      # see guide above
time_format = %H:%M:%S      # see guide above

# -----------------------------------------------------------------------------
# [hero]  — CPU / MEM / DISK
#
# meter_mode = true  → paint by thresholds (level_* + warn_at / crit_at)
# meter_mode = false → use cpu / mem / disk colors (blank → white)
# disk_mount         → filesystem to measure; falls back to /
# -----------------------------------------------------------------------------
[hero]

cpu  = #4DD0E1              # only used when meter_mode = false
mem  = #FFFFFF
disk = #81C784

disk_mount = /

meter_mode = true           # true = threshold colors; false = fixed colors above

warn_at = 60                # % where “warn” begins
crit_at = 90                # % where “crit” begins

level_ok   = #81C784        # below warn_at
level_warn = #E0C06A        # warn_at … crit_at
level_crit = #E57373        # at / above crit_at

# -----------------------------------------------------------------------------
# [secondary]  — two equal one-line slots under the hero
#
# left / right = uptime | swap | load | (blank)
# Leave both blank to hide the strip; sections below reclaim the space.
# *_color paints the value (blank → white). Labels always use label_color.
# -----------------------------------------------------------------------------
[secondary]

left  = uptime              # uptime | swap | load | blank
right = load

left_color  = #C97878       # value color (blank → white)
right_color = #4A90A8

# -----------------------------------------------------------------------------
# [interfaces]  — network rows
#
# One line per iface:  name = v4 | v6
# Empty section → hide. Config is free-form; device accepts up to 16 rows.
# -----------------------------------------------------------------------------
[interfaces]

wlp2s0  = v4
docker0 = v4

# -----------------------------------------------------------------------------
# [services]  — unit pile
#
# filter = all            → show everything
# filter =                → same (no filter)
# filter = sshd, nginx    → only these names
#
# Colors follow systemd ActiveState. Leave a color blank to keep the default.
# -----------------------------------------------------------------------------
[services]

filter = ssh, cron, docker, containerd, chrony, fail2ban, systemd-resolved, NetworkManager

active       = #81C784      # running
failed       = #E57373      # failed / dead
inactive     = #A8B4C0      # stopped
activating   = #4DD0E1      # starting
reloading    = #00FF00      # reloading config
deactivating = #E0C06A      # stopping
maintenance  = #6B7C8F      # maintenance / unknown
