[globals]

label_color =      #888888
background_color = #000000

# -----------------------------------------------------------------------------
#   token     meaning              example
#   -----     -------              -------
#   %Y        year, 4 digits       2026
#   %y        year, 2 digits       26
#   %m        month 01–12          09
#   %d        day 01–31            07
#   %b        month, short name    Sep
#   %B        month, full name     September
#   %a        weekday, short       Mon
#   %A        weekday, full        Monday
#   %H        hour 00–23           19
#   %I        hour 01–12           07
#   %M        minute 00–59         22
#   %S        second 00–59         04
#   %p        AM / PM              PM
# -----------------------------------------------------------------------------

[header]

hostname_color = #FFFFFF
date_color =     #888888
time_color =     #FFFFFF

date_format = %d-%m-%Y
time_format = %H:%M:%S

# -----------------------------------------------------------------------------
# meter_mode = true  → paint by thresholds (level_* + warn_at / crit_at)
# meter_mode = false → use cpu / mem / disk colors (blank → white)
# -----------------------------------------------------------------------------

[hero]

cpu_color =  #FFFFFF
mem_color =  #FFFFFF
disk_color = #FFFFFF

disk_mount = /

meter_mode = true

warn_at = 60
crit_at = 90

level_ok_color =   #33AA33
level_warn_color = #CCCC33
level_crit_color = #CC3333

# -----------------------------------------------------------------------------
# left / right = uptime | swap | load | (blank)
# -----------------------------------------------------------------------------

[secondary]

left  = uptime
right = load

left_color =  #FFFFFF
right_color = #FFFFFF

# -----------------------------------------------------------------------------
# One line per iface:  name = v4 | v6 | auto
#   auto = IPv4 if present, else global IPv6, else link-local
# -----------------------------------------------------------------------------

[interfaces]

wlp2s0  = auto
enp1s0  = auto
docker0 = auto

# -----------------------------------------------------------------------------
# filter = all            → show everything
# filter = sshd, nginx    → only these names (without .service)
# -----------------------------------------------------------------------------

[services]

filter = ssh, cron, docker, containerd, chrony, fail2ban, NetworkManager, systemd-resolved, systemd-networkd, systemd-journald, systemd-logind, rsyslog, unattended-upgrades, smartmontools, thermald, tty-buddy, dbus, wpa_supplicant, udisks2, fwupd, avahi-daemon, polkit

active_color =       #33AA33
failed_color =       #CC3333
inactive_color =     #888888
activating_color =   #3399CC
reloading_color =    #3399CC
deactivating_color = #CCAA33
maintenance_color =  #888888
