# tty-buddy daemon settings (/etc/tty-buddy/daemon.toml)
#
# Defaults work for a single board. udev creates /dev/tty-buddy; otherwise the
# daemon matches Espressif USB-JTAG (303a:1001). Use `tty-buddy setup` only to
# pin one board when several are attached.

device_path = "/dev/tty-buddy"
vid = 12346   # 0x303A Espressif
pid = 4097    # 0x1001 USB JTAG/serial
# serial = "aa:bb:cc:dd:ee:ff"

status_config = "/etc/tty-buddy/status.config"

# Filled by package install / configure-instance (the service user).
shell_user = "REPLACE_ME"

# true = status GUI first; OSD long-press toggles console
start_in_status = true

fps = 10.0
