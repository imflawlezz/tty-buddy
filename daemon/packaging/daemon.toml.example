# tty-buddy daemon settings (/etc/tty-buddy/daemon.toml)
#
# Fresh install: leave as-is. udev creates /dev/tty-buddy when the ESP is
# plugged in. If the symlink is missing, the daemon still matches Espressif
# USB-JTAG (303a:1001). Run `tty-buddy setup` only when several boards are
# attached and you need to pin one.

device_path = "/dev/tty-buddy"
vid = 12346   # 0x303A Espressif
pid = 4097    # 0x1001 USB JTAG/serial
# serial = "aa:bb:cc:dd:ee:ff"

status_config = "/etc/tty-buddy/status.config"

# Filled by install.sh (the user who ran sudo). Console PTY runs as this user.
shell_user = "REPLACE_ME"

# true = status GUI first; OSD long-press toggles console
start_in_status = true

fps = 10.0
