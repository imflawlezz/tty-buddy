# tty-buddy daemon settings (/etc/tty-buddy/daemon.toml)

# Prefer udev symlink; falls back to Espressif 303a:1001
device_path = "/dev/tty-buddy"
vid = 12346   # 0x303A Espressif
pid = 4097    # 0x1001 USB JTAG/serial
# serial = "aa:bb:cc:dd:ee:ff"   # pin one board when several are present

status_config = "/etc/tty-buddy/status.config"

# Must match the systemd service user. Spawns that user's login shell (not /bin/login).
shell_user = "dih"

# true = status GUI first; long-press toggles console
start_in_status = true

fps = 10.0
